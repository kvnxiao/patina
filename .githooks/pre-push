#!/usr/bin/env sh
# Patina pre-push hook.
#
# Runs the full local gate before anything leaves your machine:
#
#   just check  ==  just lint + just test + just doc + just dependencies
#     lint          = fmt check (nightly) + clippy on the host and cross targets
#     test          = cargo test --workspace --all-features --locked
#     doc           = cargo doc with warnings denied
#     dependencies  = cargo audit + cargo machete + cargo deny check
#
# Clippy does not check intra-doc links, so a hand-typed checklist that
# runs clippy alone misses them. `just check` always includes the `doc` gate.
#
# CI also runs gates this hook skips (the Windows/macOS/Linux test matrix,
# the MSRV checks, coverage), so watch the PR checks after the push lands.
#
# Bypass for an emergency push: `git push --no-verify` (CI will still gate
# the PR, so this is rarely the right call).

set -e

# No Cargo.toml means there is nothing to build or test (kept for parity with
# pre-commit; a no-op now that the workspace exists).
if [ ! -f Cargo.toml ]; then
    exit 0
fi

if ! command -v just >/dev/null 2>&1; then
    echo "pre-push: 'just' not found; it runs the local gate (just check)." >&2
    echo "  Install it: https://github.com/casey/just#installation" >&2
    echo "  (or 'brew install just' / 'cargo install just')" >&2
    echo "  To push without the gate this once: git push --no-verify" >&2
    exit 1
fi

echo "pre-push: just check (lint, test, doc, dependencies)"
if ! just check; then
    echo "" >&2
    echo "pre-push: 'just check' failed. See the output above." >&2
    echo "  Fix it, or bypass this once with: git push --no-verify" >&2
    exit 1
fi

exit 0
